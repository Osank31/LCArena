# ==============================================================================
# LCArena Backend Load Testing Environment Configuration
# ==============================================================================

# Target Service URLs
# When running load tests from host machine (Node / k6 local):
GATEWAY_URL=http://localhost:3000
PROBLEM_SERVICE_URL=http://localhost:3001
SUBMISSION_SERVICE_URL=http://localhost:3002
MAIL_SERVICE_URL=http://localhost:3003
EXECUTION_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:8000

# When running load tests inside Docker container connected to `lcarena_default` network:
# GATEWAY_URL=http://gateway:3000
# PROBLEM_SERVICE_URL=http://problem:3001
# SUBMISSION_SERVICE_URL=http://submission:3002
# MAIL_SERVICE_URL=http://mail:3003
# EXECUTION_SERVICE_URL=http://execution:3004
# AI_SERVICE_URL=http://ai-suggestion:8000

# Infrastructure URLs (for fixtures seeding/cleanup & monitoring)
MONGODB_URL=mongodb://127.0.0.1:27017/lcarena
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Test Credentials (default development fixtures)
TEST_ADMIN_EMAIL=admin@lcarena.test
TEST_ADMIN_PASSWORD=Password123
TEST_USER_EMAIL=regular@lcarena.test
TEST_USER_PASSWORD=Password123

# Performance Targets & SLA Thresholds
TARGET_P95_MS=200
TARGET_P99_MS=500
MAX_ERROR_RATE=0.01

# Execution & Safety Caps
MAX_VUS=200
DEFAULT_DURATION=30s
MAX_SUBMISSION_CONCURRENCY=50
WALL_CLOCK_TIMEOUT_MS=600000
