{
  "name": "@LCArena/mail",
  "version": "1.0.0",
  "description": "SMTP email microservice for LCArena: renders and dispatches transactional emails such as login OTPs",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@LCArena/middlewares": "*",
    "@LCArena/utils": "*",
    "express": "^5.2.1",
    "nodemailer": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^7.0.9",
    "@types/smtp-server": "^3.5.12",
    "smtp-server": "^3.19.21",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
