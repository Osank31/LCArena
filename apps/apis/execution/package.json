{
  "name": "@LCArena/evaluator",
  "version": "1.0.0",
  "description": "Asynchronous evaluation worker: consumes submission.created, executes code in a sandbox, persists the verdict and publishes submission.completed",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\"",
    "test:integration": "node --import tsx --test \"test/integration/*.e2e.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@LCArena/config": "*",
    "@LCArena/execution": "*",
    "@LCArena/middlewares": "*",
    "@LCArena/models": "*",
    "@LCArena/utils": "*",
    "express": "^5.2.1",
    "tar-stream": "^3.2.1",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/tar-stream": "^3.1.4",
    "@types/yauzl": "^3.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
