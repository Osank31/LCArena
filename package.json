{
  "name": "LCArena",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "apps/apis/*",
    "packages/*"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "redis": "^6.2.1"
  }
}
