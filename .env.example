# LCArena environment template
# Copy to .env and fill in real values: cp .env.example .env
# Required by getEnvVariable() at service boot — missing values crash the service.

# --- Docker Compose inter-service wiring (defaults below match docker-compose.yml) ---
# Auth service
PORT=3000
MONGODB_URL=mongodb://mongo:27017/lcarena
MAIL_SERVICE_URL=http://mail:3003
REDIS_HOST=redis
REDIS_PORT=6379

# Submission service
PROBLEM_URL=http://problem:3001

# Sockets service
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# --- Secrets (fill these in) ---
# Auth service
ACCESS_TOKEN_JWT_KEY=kuchbhi
REFRESH_TOKEN_JWT_KEY=kuchbhi
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=

# Problem service
OPENAI_API_KEY=

# Mail service
MAIL_USER=
MAIL_PASSWORD=

# --- Optional ---
LOG_LEVEL=info

# Note: docker-compose.yml hardcodes the infra URLs (mongo, redis, rabbitmq,
# inter-service HTTP) so containers always talk to each other by service name.
# Set these locally only when running services outside Docker.

# --- Gateway service (public entry point; expose this at :3000) ---
# Everything below is required by @LCArena/gateway.
PROBLEM_SERVICE_URL=http://problem:3001
SUBMISSION_SERVICE_URL=http://submission:3002
# Comma separated origins allowed to call the gateway with credentials.
# "*" reflects any origin, which cookie credentials require; list origins to lock it down.
CORS_ORIGIN=*

# --- Gateway tokens (optional; the defaults below apply when unset) ---
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# PROXY_TIMEOUT_MS=15000

# Execution (evaluation worker)
# PORT here is only the worker's health endpoint; it exposes no public API.
# PORT=3004
# Bounded retry: after this many failed attempts a submission is recorded as
# INTERNAL_ERROR and its message is parked on submission.created.dead.
EXECUTION_MAX_ATTEMPTS=3
# Caps for untrusted test-case archives (download size, expansion, entry count).
EXECUTION_MAX_TESTCASES_BYTES=67108864
EXECUTION_MAX_TESTCASES_ENTRIES=10000
