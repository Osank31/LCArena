# LCArena environment template
# Copy to .env and fill in real values: cp .env.example .env
# Required by getEnvVariable() at service boot — missing values crash the service.

# --- Docker Compose inter-service wiring (defaults below match docker-compose.yml) ---
# Auth service
PORT=3000
MONGODB_URL=mongodb://mongo:27017/lcarena
MAIL_SERVICE_URL=http://mail:3003
REDIS_HOST=redis
REDIS_PORT=6379

# Submission service
PROBLEM_URL=http://problem:3001

# Sockets service
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# --- Secrets (fill these in) ---
# Auth service
ACCESS_TOKEN_JWT_KEY=kuchbhi
REFRESH_TOKEN_JWT_KEY=kuchbhi
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=

# Problem service
OPENAI_API_KEY=

# --- Object Storage (MinIO for local development / Cloudflare R2 for production) ---
# For Local MinIO (defaults work out of the box with Docker Compose):
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=lcarena-testcases
S3_FORCE_PATH_STYLE=true
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# For Cloudflare R2 (Free Tier compatible: 10GB storage, 10M Class B operations/month free):
# 1. Sign up / log in to Cloudflare Dashboard -> R2 Object Storage.
# 2. Click "Create bucket" and name it (e.g. `lcarena-testcases`).
# 3. Under "Manage R2 API Tokens", click "Create API Token" with Object Read & Write permissions.
# 4. Set the following environment variables:
#    S3_ENDPOINT=https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
#    S3_REGION=auto
#    S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
#    S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
#    S3_BUCKET_NAME=lcarena-testcases
#    S3_FORCE_PATH_STYLE=false

# Mail service
MAIL_USER=
MAIL_PASSWORD=

# --- Optional ---
LOG_LEVEL=info

# Note: docker-compose.yml hardcodes the infra URLs (mongo, redis, rabbitmq,
# inter-service HTTP) so containers always talk to each other by service name.
# Set these locally only when running services outside Docker.

# --- Gateway service (public entry point; expose this at :3000) ---
# Everything below is required by @LCArena/gateway.
PROBLEM_SERVICE_URL=http://problem:3001
SUBMISSION_SERVICE_URL=http://submission:3002
# Comma separated origins allowed to call the gateway with credentials.
# "*" reflects any origin, which cookie credentials require; list origins to lock it down.
CORS_ORIGIN=*

# --- Gateway tokens (optional; the defaults below apply when unset) ---
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# PROXY_TIMEOUT_MS=15000

# Execution (evaluation worker)
# PORT here is only the worker's health endpoint; it exposes no public API.
# PORT=3004
# Bounded retry: after this many failed attempts a submission is recorded as
# INTERNAL_ERROR and its message is parked on submission.created.dead.
EXECUTION_MAX_ATTEMPTS=3
# Caps for untrusted test-case archives (download size, expansion, entry count).
EXECUTION_MAX_TESTCASES_BYTES=67108864
EXECUTION_MAX_TESTCASES_ENTRIES=10000

# --- Mail service (SMTP) ---
# Any SMTP relay works. Examples:
#   Gmail:    MAIL_HOST=smtp.gmail.com  MAIL_PORT=587 MAIL_SECURE=false (use an app password)
#   Mailtrap: MAIL_HOST=sandbox.smtp.mailtrap.io MAIL_PORT=2525 MAIL_SECURE=false
#   TLS 465:  MAIL_SECURE=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM=LCArena <no-reply@lcarena.local>

# Background delivery queue: POST /otp queues the mail and answers 202, so a
# slow relay never blocks /auth/send-otp. Sizing is per mail-service instance.
MAIL_QUEUE_CONCURRENCY=2
MAIL_QUEUE_MAX_SIZE=500
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_DELAY_MS=500
MAIL_DRAIN_TIMEOUT_MS=10000

# Shared secret between the gateway and the mail service (protects /otp).
# Generate one, e.g.: node -e "console.log(require('crypto').randomUUID())"
MAIL_SERVICE_TOKEN=
