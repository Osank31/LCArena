{
  "name": "LCArena",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=./packages/backend/* --filter=./apps/apis/* --filter=!./apps/apis/ai-suggestion-service",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check-types:backend": "turbo run check-types --filter=./packages/backend/* --filter=./apps/apis/* --filter=!./apps/apis/ai-suggestion-service",
    "test": "npm run test:backend",
    "test:backend": "turbo run test:unit --filter=./packages/backend/* --filter=./apps/apis/* --filter=!./apps/apis/ai-suggestion-service",
    "test:coverage": "node scripts/test/coverage.mjs",
    "test:load": "node tests/load/runners/suite-runner.js --type=all",
    "test:load:smoke": "node tests/load/runners/suite-runner.js --type=smoke",
    "test:load:baseline": "node tests/load/runners/suite-runner.js --type=baseline",
    "test:load:stepped": "node tests/load/runners/suite-runner.js --type=stepped",
    "test:load:stress": "node tests/load/runners/suite-runner.js --type=stress",
    "test:load:spike": "node tests/load/runners/suite-runner.js --type=spike",
    "test:load:soak": "node tests/load/runners/suite-runner.js --type=soak",
    "test:load:recovery": "node tests/load/runners/suite-runner.js --type=recovery",
    "test:load:endpoints": "node tests/load/runners/suite-runner.js --type=endpoints",
    "test:load:services": "node tests/load/runners/suite-runner.js --type=services",
    "test:load:lifecycle": "node tests/load/runners/suite-runner.js --type=lifecycle",
    "test:all": "npm run test:all:fast && npm run test:integration",
    "seed:problems": "node scripts/test/seed-problems.mjs",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:health": "node scripts/docker/health.mjs",
    "graphify": "graphify",
    "graphify:update": "graphify update ."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "tsx": "^4.23.15",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "apps/apis/*",
    "packages/*",
    "packages/backend/*",
    "packages/ui/*"
  ],
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "dotenv": "^18.0.3",
    "monaco-editor": "^0.56.0",
    "next-themes": "^0.4.6",
    "tailwindcss": "^4.3.3"
  }
}
